# ====================================================================
# DesiLearCode Environment Variables (Production & Local Development)
# ====================================================================
# SECURITY NOTICE:
# Never commit real credentials to version control.
# If any credentials have ever been committed or exposed, rotate them
# immediately via the Supabase Project Dashboard (Settings -> API -> Rotate Secret).
# ====================================================================

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration (Required for authentication and public queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Private Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Platform Safeguarding Officer Contact
NEXT_PUBLIC_SAFEGUARDING_EMAIL=safeguarding@desilearncode.org
