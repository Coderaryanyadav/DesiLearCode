# ====================================================================
# TechForKids Environment Variables
# ====================================================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Keys (For optional Supabase database connectivity)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Private Service Role Key (NEVER expose in client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Platform Governance
NEXT_PUBLIC_SAFEGUARDING_EMAIL=safeguarding@techforkids.org
